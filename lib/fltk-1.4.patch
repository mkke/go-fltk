+      // -finishLaunching; without it AppKit never installs its default
+      // Apple-event handlers, so kAEQuitApplication (sent by the dock
+      // context-menu Quit and by `osascript "tell app to quit"`) silently
+      // fails with errAEEventNotHandled instead of reaching
+      // -applicationShouldTerminate:. Calling -finishLaunching here closes
+      // that gap; AppKit guards it internally (_finishedLaunching flag)
+      // so a second invocation is a no-op for callers who already ran it.
+      [NSApp finishLaunching];
